NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=uniflow

# Google OAuth — create credentials in Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Optional. If unset, OAuth callback URL uses RENDER_EXTERNAL_URL on Render, else request host.
# GOOGLE_CALLBACK_URL=https://your-api.onrender.com/api/auth/google/callback
FRONTEND_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# On Render, set OAUTH_DEBUG=1 temporarily to include error detail + redirectUri in JSON responses.

# Event reminders / Redis (optional, but required if you want scheduled reminders)
# If Redis is not configured, reminders are skipped and API still works.
# REDIS_URL=redis://localhost:6379
# or:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# DISABLE_EVENT_REMINDERS=true

# Use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Cloudinary — PDF storage for course files (flashcards / quizzes / summary on Render).
# Same CLOUDINARY_URL as Django UNIFLOW_AI. If unset, files stay on local disk only (dev).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Internal API key for backend-to-backend PDF fetches (Django AI -> Node backend).
# Set same value in UNIFLOW_AI as MAIN_API_INTERNAL_KEY.
# INTERNAL_API_KEY=change-me-long-random-string
# On Render: set this in backend service env vars and set the same value
# as MAIN_API_INTERNAL_KEY in the UNIFLOW_AI service.

# Sign in with Apple — must match native bundle ID (default com.uniflow.app); optional Services ID for web tokens
# APPLE_CLIENT_ID=com.uniflow.app
# APPLE_SERVICES_ID=com.uniflow.app.signin
