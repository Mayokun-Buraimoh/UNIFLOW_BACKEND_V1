NODE_ENV=development
PORT=3000

# PostgreSQL (Render or local)
# Option A: full connection URL (recommended on Render). Leave DB_* unset if using this.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# Option B: individual fields
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=uniflow
# DB_DIALECT=postgres
# Enable SSL (auto-on for Render hosts and DATABASE_URL with sslmode=require)
# DB_SSL=true

# Google OAuth — create credentials in Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# OAuth iOS client (Google Console → iOS, same bundle as the app). Verifies native id_token `aud`; optional if web-only.
# GOOGLE_IOS_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Native/Capacitor: GET /api/auth/google/config (public IDs), POST /api/auth/google { idToken } → JWT (use web client as serverClientId on iOS).
# Diagnose TestFlight / env: from backend/ run `npm run check:google` or `API_BASE_URL=https://your-api.onrender.com/api npm run check:google`
# Optional override — must be a SINGLE URL (never comma-separate two). If unset, the API builds
# redirect_uri from the request (localhost when you run `npm run dev`, Render host when deployed).
# GOOGLE_CALLBACK_URL=https://your-api.onrender.com/api/auth/google/callback
#
# ERR_CONNECTION_REFUSED on localhost:3000 means nothing is listening locally. Either run the API
# here (`npm run dev`) or open your hosted URL in the browser, e.g. https://YOUR-SERVICE.onrender.com/api/auth/google
# Web / browser return after Google (default when unset: FRONTEND_URL + path, else localhost:5173).
FRONTEND_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Optional: explicit native iOS return (TestFlight). If unset, same URL is derived from GOOGLE_IOS_CLIENT_ID when
# the app starts OAuth as GET /api/auth/google?app=ios (Capacitor iOS does this automatically from the SPA).
# FRONTEND_GOOGLE_REDIRECT_URI_IOS=com.googleusercontent.apps.YOUR_PREFIX:/oauthredirect
# Legacy: you could set FRONTEND_GOOGLE_REDIRECT_URI to the Google scheme only — then web OAuth breaks in browsers.
# Capacitor custom scheme alternative (set FRONTEND_GOOGLE_REDIRECT_URI_IOS or derive via iOS client id):
# FRONTEND_GOOGLE_REDIRECT_URI_IOS=com.uniflowprod.app.ios:///auth/google/callback
# On Render, set OAUTH_DEBUG=1 temporarily to include error detail + redirectUri in JSON responses.

# Event reminders / Redis (optional, but required if you want scheduled reminders)
# If Redis is not configured, reminders are skipped and API still works.
# REDIS_URL=redis://localhost:6379
# or:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# DISABLE_EVENT_REMINDERS=true

# Use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Cloudinary — PDF storage for course files (flashcards / quizzes / summary on Render).
# Same CLOUDINARY_URL as Django UNIFLOW_AI. If unset, files stay on local disk only (dev).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# If uploads return 403 from Cloudinary, verify API key/secret and cloud name in the Dashboard.
# After a successful upload the API normally deletes the local PDF; set this to keep a copy on disk too:
# KEEP_LOCAL_FILE_AFTER_CLOUDINARY_UPLOAD=true

# Course uploads: .doc/.docx/.ppt/.pptx/etc. are converted to PDF with libreoffice-convert, which
# shells out to LibreOffice (`soffice` on PATH). Render’s default Node buildpack does NOT include it.
# Use Docker for this service (see backend/Dockerfile), or install LibreOffice on your VM, or use an external converter.
# macOS dev: `brew install --cask libreoffice` then ensure `soffice` is on PATH (may need a symlink into /usr/local/bin).

# Internal API key for backend-to-backend PDF fetches (Django AI -> Node backend).
# Set same value in UNIFLOW_AI as MAIN_API_INTERNAL_KEY.
# INTERNAL_API_KEY=change-me-long-random-string
# On Render: set this in backend service env vars and set the same value
# as MAIN_API_INTERNAL_KEY in the UNIFLOW_AI service.

# Sign in with Apple — must match native bundle ID (default com.uniflow.app); optional Services ID for web tokens
# APPLE_CLIENT_ID=com.uniflow.app
# APPLE_SERVICES_ID=com.uniflow.app.signin

# Ruby voice assistant (OpenAI: Whisper + Chat + TTS). Required for /api/voice/*.
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# Voice uploads are limited to 4 MB per request; rate limit ~40 requests/minute per user.
