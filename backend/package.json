{
  "name": "uniflow-backend",
  "version": "1.0.0",
  "description": "UniFlow Backend API",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "worker:dev": "ts-node src/workers/runEventReminderWorker.ts",
    "worker:start": "node dist/workers/runEventReminderWorker.js",
    "build": "tsc",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "view-db": "ts-node view-database.ts",
    "backfill:cloudinary:dry": "ts-node scripts/backfill-cloudinary-course-files.ts --dry-run",
    "backfill:cloudinary": "ts-node scripts/backfill-cloudinary-course-files.ts",
    "test:apis": "node scripts/test-all-apis.mjs",
    "check:google": "node scripts/check-google-auth.mjs"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.73.5",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.3.0",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "libreoffice-convert": "^1.8.1",
    "multer": "^2.1.1",
    "mysql2": "^3.6.5",
    "openai": "^4.104.0",
    "pg": "^8.16.3",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.37",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "api",
    "backend",
    "uniflow"
  ],
  "author": "",
  "license": "ISC"
}
